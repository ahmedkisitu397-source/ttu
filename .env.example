# ---------- TTu configuration (copy to .env and fill in; never commit .env) ----------
APP_ENV=development            # set to "production" on the live server (disables dev-only tools)
PORT=8787
APP_URL=http://localhost:8787  # public URL in production, e.g. https://ttu.hadtah.com (used for payment redirects)
SESSION_SECRET=                # long random string in production: openssl rand -hex 32
DATABASE_PATH=./data/ttu.db

# ---------- AI (Google Gemini native generateContent API). Empty key = demo mode ----------
AI_BASE_URL=https://generativelanguage.googleapis.com/v1beta
AI_MODEL=gemini-3.1-flash-lite
AI_API_KEY=                    # enables real answers + Google Search grounding (falls back if the free-tier search quota is hit)
AI_REASONING_EFFORT=           # optional, used only on the OpenAI-compatible fallback path: minimal | low | medium | high

# ---------- Sign-in codes by email: Resend OR SMTP. Neither = dev mode (code printed in server log) ----------
RESEND_API_KEY=
RESEND_FROM="TTu <no-reply@hadtah.com>"
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM="TTu <no-reply@hadtah.com>"

# ---------- Payments: Flutterwave (weekly plan) ----------
FLW_PUBLIC_KEY=
FLW_SECRET_KEY=
FLW_SECRET_HASH=               # same value you type in Flutterwave dashboard > Settings > Webhooks > Secret hash
WEEKLY_PRICE_USD=0.81
WEEKLY_PRICE_UGX=3000          # mobile-money price in shillings (Flutterwave mobile money UG needs UGX)

# ---------- Limits ----------
DAILY_QUESTIONS=15
FREE_DOWNLOADS=20

# ---------- Optional sources ----------
YOUTUBE_API_KEY=               # YouTube Data API v3 (videos shown/embedded only, never downloaded)
GOOGLE_CSE_KEY=                # Google Programmable Search JSON API key
GOOGLE_CSE_ID=                 # Programmable Search Engine ID (cx)
OPENALEX_API_KEY=              # free key from openalex.org/settings/api (higher daily budget)
CONTACT_EMAIL=support@hadtah.com   # sent to OpenAlex/Crossref "polite pool"
REDDIT_CLIENT_ID=              # Reddit "script/installed app" credentials; Reddit blocks most anonymous server traffic
REDDIT_CLIENT_SECRET=
MASTODON_INSTANCE=mastodon.social
WIKI_LANG=en
