{
  "name": "ttu-desktop",
  "private": true,
  "version": "0.1.0",
  "description": "TTu desktop app (Electron shell around the hosted TTu PWA)",
  "main": "main.js",
  "scripts": { "start": "electron .", "dist:win": "electron-builder --win nsis" },
  "devDependencies": { "electron": "^33.0.0", "electron-builder": "^25.0.0" },
  "build": {
    "appId": "com.hadtah.ttu",
    "productName": "TTu",
    "copyright": "© Hadtah",
    "win": { "target": "nsis", "icon": "../public/icons/icon-512.png" },
    "nsis": { "oneClick": false, "allowToChangeInstallationDirectory": true, "shortcutName": "TTu" }
  }
}
