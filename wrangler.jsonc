{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "ttu",
  "main": "worker.js",
  "compatibility_date": "2026-11-01",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": true,
  "preview_urls": false,
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "html_handling": "auto-trailing-slash",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*", "/healthz"]
  },
  "alias": { "nodemailer": "./stubs/nodemailer.js" },
  "d1_databases": [
    { "binding": "DB", "database_name": "ttu", "database_id": "62c70f6a-378b-428c-8f18-b48b96f027c6", "migrations_dir": "migrations" }
  ],
  "vars": {
    // Production: sign-in codes are emailed (RESEND_API_KEY secret + RESEND_FROM) and the test-week
    // toggle is disabled. FREE_LAUNCH_UNTIL still waives subscriptions through 15 Dec 2026 (Kampala).
    "APP_ENV": "production",
    "APP_URL": "https://ttu.hadtah.com",
    "RESEND_FROM": "TTu <no-reply@hadtah.com>",
    "FREE_LAUNCH_UNTIL": "2026-12-15",
    "DAILY_QUESTIONS": "20",
    "DAILY_YOUTUBE_SEARCHES": "80",
    "DAILY_AI_CALLS": "400"
  },
  "observability": { "enabled": true }
}
